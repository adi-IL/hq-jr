[Unit]
Description=Update hq-jr container from GHCR
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Change User/Group to the deploy account on other hosts. It must be able to use Docker.
User=adi-IL
Group=adi-IL
SupplementaryGroups=docker
ExecStart=/opt/hq-jr/deploy/update.sh
