[Unit]
Description=Update hq-jr container from GHCR
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# Change User and Group to the deploy account on this host. It must be a member of the docker group.
User=adi-IL
Group=adi-IL
SupplementaryGroups=docker
# /opt/hq-jr/deploy is a plain directory that holds the deploy files from the released
# image. It is not a git checkout and this unit never pulls from GitHub.
# Uncomment the next line to refresh the deploy files before every update. It pulls the
# image that compose.yaml runs and keeps the host compose.yaml. A failed refresh is not fatal.
# It runs scripts from that image on this host with Docker access, so enable it only if you
# trust the registry as much as the host. See deploy/README.md.
# ExecStartPre=-/opt/hq-jr/deploy/refresh-deploy-files.sh
ExecStart=/opt/hq-jr/deploy/update.sh
