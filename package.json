{
  "name": "hq-jr",
  "version": "0.1.0",
  "description": "Self-hosted GitHub App that reviews PRs with Vertex AI, remembers past findings, and can reproduce bugs in a sandbox before it speaks.",
  "homepage": "https://github.com/adi-IL/hq-jr",
  "repository": "https://github.com/adi-IL/hq-jr",
  "main": "dist/index.js",
  "bin": {
    "hq-jr": "dist/cli.js"
  },
  "type": "module",
  "scripts": {
    "build": "tsc",
    "start": "probot run ./dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit"
  },
  "keywords": [
    "ai-code-review",
    "code-review",
    "developer-tools",
    "github-app",
    "pull-request",
    "probot",
    "sandbox",
    "self-hosted",
    "sqlite",
    "typescript",
    "vertex-ai",
    "hq-jr"
  ],
  "author": "Aditya Gaurav <adi-IL>",
  "license": "Apache-2.0",
  "dependencies": {
    "@google/genai": "^2.3.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.4.5",
    "probot": "^13.4.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.5.5",
    "smee-client": "^5.0.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "app.yml",
    ".env.example"
  ]
}
