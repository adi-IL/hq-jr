# Required variables for the GitHub App and Google Cloud project
APP_ID=
PRIVATE_KEY=
WEBHOOK_SECRET=

# Google Cloud Vertex AI Configuration (global location required for Gemini 4 models)
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id

# Optional model and runtime defaults matching src/config.ts
WEBHOOK_PROXY_URL=https://smee.io/your_smee_channel_id
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/application_default_credentials.json

# Model & Thinking Routing Configuration (defaults match src/config.ts)
# Tier 1 triage model (file risk classification) and thinking level (LOW|MEDIUM|HIGH|XHIGH).
HQ_JR_MODEL_TIER1=gemini-4-hydrogen
HQ_JR_THINKING_TIER1=HIGH
# Tier 2 deep review model (semantic review and security audit) and thinking level.
HQ_JR_MODEL_TIER2=gemini-4-hydrogen
HQ_JR_THINKING_TIER2=HIGH
# Escalation model used when triage risk reaches HQ_JR_ESCALATION_MIN_RISK
# (Global PayGo: $2/$10 per 1M through 2026-11-30, $4/$20 from 2026-12-01 vs Hydrogen $1.50/$7.50).
# gemini-4-argon supports thinking levels LOW, MEDIUM, and HIGH (rejects XHIGH).
HQ_JR_MODEL_ESCALATION=gemini-4-argon
HQ_JR_THINKING_ESCALATION=HIGH
# Minimum triage risk (LOW, MEDIUM, or HIGH) that routes deep review to HQ_JR_MODEL_ESCALATION.
HQ_JR_ESCALATION_MIN_RISK=HIGH
# Model and thinking level for replies in review discussion threads.
HQ_JR_MODEL_DISCUSSION=gemini-4-hydrogen
HQ_JR_THINKING_DISCUSSION=HIGH
# Model and thinking level for autonomous remediation synthesis.
HQ_JR_MODEL_REMEDIATION=gemini-4-hydrogen
HQ_JR_THINKING_REMEDIATION=HIGH
# Model and thinking level used by the health probe (/healthz, hq-jr health).
HQ_JR_MODEL_HEALTH=gemini-4-hydrogen
HQ_JR_THINKING_HEALTH=LOW
# Output token cap for HQ_JR_MODEL_ESCALATION only. Triage, Tier 2 deep review, discussion, remediation, and health calls do not send maxOutputTokens.
HQ_JR_ESCALATION_MAX_OUTPUT_TOKENS=32768
# Sandbox verification agent for Tier 3.
HQ_JR_AGENT_TIER3=antigravity-preview-05-2026
HQ_JR_AI_TIMEOUT_MS=900000
HQ_JR_DB_PATH=./data/hq-jr.db

PORT=3000
NODE_ENV=development
LOG_LEVEL=info
