# Required variables for the GitHub App and Google Cloud project
APP_ID=
PRIVATE_KEY=
WEBHOOK_SECRET=
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id

# Optional model and runtime defaults matching src/config.ts
WEBHOOK_PROXY_URL=https://smee.io/your_smee_channel_id
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/application_default_credentials.json

# Tier 1 triage model for file risk classification.
HQ_JR_MODEL_TIER1=gemini-3.8-flash
# Tier 2 deep review model for semantic review and security audit.
HQ_JR_MODEL_TIER2=gemini-3.8-flash
# Escalation model used when triage risk reaches HQ_JR_ESCALATION_MIN_RISK.
HQ_JR_MODEL_ESCALATION=gemini-4-argon
# Minimum triage risk (LOW, MEDIUM, or HIGH) that routes deep review to HQ_JR_MODEL_ESCALATION.
HQ_JR_ESCALATION_MIN_RISK=HIGH
# Model for replies in review discussion threads.
HQ_JR_MODEL_DISCUSSION=gemini-3.8-flash
# Model for autonomous remediation synthesis.
HQ_JR_MODEL_REMEDIATION=gemini-3.8-flash
# Model used by the health probe.
HQ_JR_MODEL_HEALTH=gemini-3.8-flash
# Output token cap for HQ_JR_MODEL_ESCALATION only. Triage, Tier 2 deep review, discussion, remediation, and health calls do not send maxOutputTokens.
HQ_JR_ESCALATION_MAX_OUTPUT_TOKENS=32768
# Sandbox verification agent for Tier 3.
HQ_JR_AGENT_TIER3=antigravity-preview-05-2026
HQ_JR_AI_TIMEOUT_MS=900000
HQ_JR_DB_PATH=./data/hq-jr.db

PORT=3000
NODE_ENV=development
LOG_LEVEL=info
