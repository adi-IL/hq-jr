# GitHub App Configuration
APP_ID=
PRIVATE_KEY=
WEBHOOK_SECRET=
WEBHOOK_PROXY_URL=https://smee.io/your_smee_channel_id

# Google Cloud Vertex AI Configuration
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
GOOGLE_CLOUD_LOCATION=global
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/application_default_credentials.json

# Model Routing Configuration (defaults match src/config.ts)
# Tier 1 triage model (file risk classification).
HQ_JR_MODEL_TIER1=gemini-3.8-flash
# Tier 2 deep review model (semantic review and security audit).
HQ_JR_MODEL_TIER2=gemini-3.8-flash
# Escalation model used when triage risk reaches the threshold below (costs about 2.7x Flash per token).
HQ_JR_MODEL_ESCALATION=gemini-4-argon
# Minimum triage risk (LOW|MEDIUM|HIGH) that routes the deep review to the escalation model.
HQ_JR_ESCALATION_MIN_RISK=HIGH
# Model for replies in review discussion threads.
HQ_JR_MODEL_DISCUSSION=gemini-3.8-flash
# Model for autonomous remediation synthesis.
HQ_JR_MODEL_REMEDIATION=gemini-3.8-flash
# Model used by the health probe.
HQ_JR_MODEL_HEALTH=gemini-3.8-flash
# Maximum output tokens per model call (caps billed completions on the escalation model).
HQ_JR_MAX_OUTPUT_TOKENS=32768
# Optional override for Tier 2: gemini-3.1-pro-preview
HQ_JR_AGENT_TIER3=antigravity-preview-05-2026
HQ_JR_DB_PATH=./data/hq-jr.db

# Server Configuration
PORT=3000
NODE_ENV=development
LOG_LEVEL=info
